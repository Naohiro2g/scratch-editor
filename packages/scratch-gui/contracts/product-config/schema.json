{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Naohiro2g/scratch-editor/packages/scratch-gui/contracts/product-config/schema.json",
  "title": "McRemote Scratch image-owned product configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "homepage_url",
    "notices"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "homepage_url": {
      "type": "string",
      "minLength": 1
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "body"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "link": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "href",
              "label"
            ],
            "properties": {
              "href": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}

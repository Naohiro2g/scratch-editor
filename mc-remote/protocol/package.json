{
  "name": "@mc-remote/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "McRemote wire contract (JSON-RPC 2.0 types and constants). Dependency-free leaf mirroring mc-remote-knowledge 10-protocol.",
  "license": "AGPL-3.0-only",
  "author": "Code2CreateClub",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/protocol.js",
      "types": "./dist/index.d.ts"
    }
  },
  "module": "dist/protocol.js",
  "types": "dist/index.d.ts",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && vite build",
    "clean": "rimraf coverage dist",
    "dev": "vite",
    "format": "prettier --write . && eslint --fix",
    "lint": "eslint && prettier --check .",
    "prepublishOnly": "echo \"Please publish through CI only.\" && exit 1",
    "test": "npm run lint && vitest run"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "devDependencies": {
    "eslint": "9.39.4",
    "eslint-config-scratch": "14.1.31",
    "prettier": "3.8.4",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "unplugin-dts": "1.0.2",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.9"
  }
}

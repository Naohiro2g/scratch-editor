{
  "name": "@mc-remote/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Thin transparent wss⇄TCP proxy between the Scratch editor and a McRemote Sandbox.",
  "license": "AGPL-3.0-only",
  "author": "Code2CreateClub",
  "type": "module",
  "main": "dist/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && vite build",
    "clean": "rimraf coverage dist",
    "dev": "vite build --watch",
    "format": "prettier --write . && eslint --fix",
    "lint": "eslint && prettier --check .",
    "prepublishOnly": "echo \"Please publish through CI only.\" && exit 1",
    "start": "node dist/main.js",
    "test": "npm run lint && vitest run"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "dependencies": {
    "@mc-remote/protocol": "*",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/ws": "8.18.1",
    "eslint": "9.39.4",
    "eslint-config-scratch": "14.1.31",
    "prettier": "3.8.4",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.9"
  }
}

{
  "name": "@mc-remote/live",
  "version": "0.1.0",
  "private": true,
  "description": "WireScope read-only observer web app and observer contract.",
  "license": "AGPL-3.0-only",
  "author": "Code2CreateClub",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/observer.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "types": "dist/types/index.d.ts",
  "directories": {
    "test": "test"
  },
  "files": [
    "dist",
    "test/fixtures"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.lib.config.js && tsc --project tsconfig.build.json",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "clean": "rimraf coverage dist",
    "dev": "vite",
    "format": "prettier --write . && eslint --fix",
    "lint": "eslint && prettier --check .",
    "prepublishOnly": "echo \"Please publish through CI only.\" && exit 1",
    "preview": "vite preview",
    "test": "npm run lint && vitest run"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "eslint": "9.39.4",
    "eslint-config-scratch": "14.1.31",
    "jszip": "3.10.1",
    "prettier": "3.8.4",
    "rimraf": "6.1.2",
    "typescript": "5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "4.1.9"
  }
}
